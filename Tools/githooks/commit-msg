#!/bin/sh
# hm-guard commit-msg hook (unity profile, PUBLIC repository): keeps secrets, absolute user paths and
# private terms out of commit messages.
# Install: Tools/install_hooks.sh   Rules and bypass: docs/GIT.md
HM_GUARD_PROFILE=unity
here=$(cd "$(dirname "$0")" && pwd)
. "$here/hm-guard.sh"
hm_guard commit-msg --commit-msg "$1"
exit $?
